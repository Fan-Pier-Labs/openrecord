{
  "name": "openrecord-mcpb",
  "version": "2.3.0",
  "description": "Claude Desktop Extension for OpenRecord — read and manage MyChart health data through Claude.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsup",
    "build:applet": "bun scripts/build-calendar-applet.ts",
    "dev": "tsup --watch",
    "dev:reload": "bun run build && node dev/dev-reload.mjs",
    "dev:proxy": "./node_modules/.bin/mcpmon --watch dist --ext cjs -- node dist/server.cjs",
    "pack": "bun install --os='*' --cpu='*' && bun run build && bun run build:applet && bun run verify-binaries && npx -y @anthropic-ai/mcpb pack . openrecord.mcpb",
    "smoke": "bun run build && node smoke.mjs",
    "test": "bun test --isolate .unit.test.ts .integration.test.ts",
    "verify-binaries": "node scripts/verify-native-binaries.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^1.3.0",
    "@sentry/node": "^11.12.0",
    "cheerio": "^1.2.0",
    "compare-versions": "^6.1.1",
    "fetch-cookie": "^3.2.0",
    "html-to-text": "^10.0.1",
    "jpeg-js": "^0.4.4",
    "js-base64": "^3.9.6",
    "markdown-table": "^3.1.0",
    "node-sqlite3-wasm": "^0.8.61",
    "pica": "^9.0.1",
    "totp-generator": "^2.0.1",
    "tough-cookie": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/pica": "^9.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "mcpmon": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
