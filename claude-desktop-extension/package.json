{
  "name": "openrecord-mcpb",
  "version": "0.1.0",
  "description": "Claude Desktop Extension for OpenRecord — read and manage MyChart health data through Claude.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsup",
    "dev": "tsup --watch",
    "dev:reload": "bun run build && node dev/dev-reload.mjs",
    "dev:proxy": "./node_modules/.bin/mcpmon --watch dist --ext cjs -- node dist/server.cjs",
    "pack": "bun run build && npx -y @anthropic-ai/mcpb pack . openrecord.mcpb",
    "smoke": "bun run build && node smoke.cjs",
    "test": "bun test --isolate .unit.test.ts .integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "fetch-cookie": "^3.2.0",
    "jpeg-js": "^0.4.4",
    "node-sqlite3-wasm": "^0.8.60",
    "totp-generator": "^2.0.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "mcpmon": "^1.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
