{
  "name": "mychart-cli",
  "version": "1.0.0",
  "description": "Programmatic access to Epic MyChart patient portals: login, scrape every section of a patient's chart, and act on it.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Fan Pier Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fan-Pier-Labs/openrecord.git",
    "directory": "npm-package"
  },
  "homepage": "https://github.com/Fan-Pier-Labs/openrecord/tree/main/npm-package",
  "keywords": [
    "mychart",
    "epic",
    "ehr",
    "health",
    "medical-records",
    "patient-portal",
    "scraper"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "mychart-cli": "dist/cli.cjs"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate .unit.test.ts .integration.test.ts",
    "prepublishOnly": "bun run build",
    "check:publish": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "fzstd": "^0.1.1",
    "html-to-text": "^10.0.1",
    "jpeg-js": "^0.4.4",
    "js-base64": "^3.9.3",
    "markdown-table": "^3.0.4",
    "mkdirp": "^3.0.1",
    "sharp": "^0.35.3",
    "totp-generator": "^2.0.1",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.2.0",
    "publint": "^0.3.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
