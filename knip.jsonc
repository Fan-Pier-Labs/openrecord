{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // One workspace per package. The four clients bundle the shared scraper core
  // (`scrapers/`, `shared/`) rather than depending on it as a package, so each
  // one declares dependencies whose only importers live in the root workspace —
  // knip scopes dependency use per workspace, hence the `ignoreDependencies`
  // lists below.
  "workspaces": {
    ".": {
      "entry": [
        "dev-scripts/*.ts",
        "scrapers/list-all-mycharts/fetch-mychart-instances.ts",
        "scrapers/list-all-mycharts/probes/*.ts",
        "**/*.test.ts",
        // Claude Code's worktrees are gitignored, but knip still globs into them.
        "!.claude/**"
      ],
      "project": [
        "scrapers/**/*.ts",
        "shared/**/*.ts",
        "dev-scripts/**/*.ts",
        "openrecord-splash/*.ts",
        "openrecord-splash/__tests__/**/*.ts",
        "tests/**/*.ts"
      ],
      // Loaded through `require('expo/fetch')` inside a try/catch: present in
      // the Expo app, absent (and expected to throw) under Node and Bun.
      "ignoreDependencies": ["expo"]
    },
    // Client-only shared code: the capability registry and the MCP server both
    // clients bundle. Its package.json holds the MCP server's dependencies.
    "clients/shared": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "clients/claude-desktop-extension": {
      // The setup widget's entry is bundled by path (scripts/bundle-setup-widget.ts), never imported;
      // so is the calendar binary's (scripts/build-calendar-applet.ts, `bun build --compile`).
      "entry": ["dev/*.mjs", "scripts/*.mjs", "src/setup-widget/main.tsx", "src/google-calendar/worker.ts"],
      // The MCP server in clients/shared imports @napi-rs/keyring, @sentry/node,
      // jpeg-js and pica; they stay here because this package's node_modules is
      // what ships inside the .mcpb (keyring is native and can't be bundled) and
      // what the build falls back to.
      "ignoreDependencies": [
        "@napi-rs/keyring",
        "@sentry/node",
        "jpeg-js",
        "pica",
        "cheerio",
        "compare-versions",
        "fetch-cookie",
        "html-to-text",
        "@types/html-to-text",
        "js-base64",
        "markdown-table",
        "node-sqlite3-wasm",
        "totp-generator",
        "tough-cookie"
      ]
    },
    "clients/expo-app": {
      // Referenced by path from metro.config.js / app.config.ts, never imported.
      "entry": ["shims/*.{ts,js}", "plugins/*.js"],
      "ignoreDependencies": [
        "cheerio",
        "compare-versions",
        "fzstd",
        "html-to-text",
        "@types/html-to-text",
        "jpeg-js",
        "js-base64",
        "markdown-table",
        "tough-cookie",
        "totp-generator",
        // Knip's Expo plugin assumes these ship with every Expo app; this one
        // uses neither.
        "expo-updates",
        "expo-system-ui"
      ]
    },
    "fake-mychart": {
      "ignore": [
        // Page CSS and inline page scripts, read off disk by `lib/html/assets.ts`
        // so Next never rewrites them — see the comment at the top of that file.
        "src/lib/html/assets/**",
        // Generated from live captures. A skeleton no handler conforms to yet is
        // still the record of what a real instance answered, so it stays.
        "src/data/realShapes.ts"
      ],
      // Invoked as a python module by `bun run deploy`, not imported.
      "ignoreDependencies": ["deploy"]
    },
    "clients/npm-package": {
      "entry": ["examples/*.ts"],
      // @napi-rs/keyring is imported by clients/shared/mcp-server (`mychart-cli
      // mcp`); it is native, so it ships as a real dependency, not in the bundle.
      "ignoreDependencies": [
        "@napi-rs/keyring",
        "cheerio",
        "compare-versions",
        "date-fns",
        "fzstd",
        "html-to-text",
        "@types/html-to-text",
        "jpeg-js",
        "js-base64",
        "markdown-table",
        "totp-generator",
        "tough-cookie"
      ]
    },
    "openrecord-demo-lambda": {
      "entry": ["src/*.mjs"],
      // Provided by the AWS Lambda Node runtime, imported lazily.
      "ignoreDependencies": ["@aws-sdk/client-dynamodb"]
    },
    // Its entry, src/main.tsx, is found through demo.html by knip's Vite plugin.
    "openrecord-splash/demo": {}
  }
}
