  "scripts": {
    "fix": "eslint --fix",
    "lint": "eslint",
    "lint:web": "cd web && eslint",
    "dev_mock": "OPENRECORD_MOCK_DATA=true bun run dev",
    "cli": "bun npm-package/cli/entry.ts",
    "test": "bun test --isolate scrapers/myChart/__tests__/*.test.ts scrapers/myChart/eunity/__tests__/*.test.ts shared/__tests__/*.test.ts openclaw-plugin/src/__tests__/*.test.ts npm-package/cli/__tests__/*.test.ts expo-app/src/lib/*/__tests__/*.test.ts claude-desktop-extension/src/__tests__/*.test.ts openrecord-splash/__tests__/*.test.ts openrecord-splash/demo/__tests__/*.test.ts openrecord-demo-lambda/src/__tests__/*.test.ts && cd web && bun test --isolate",
    "test:unit": "bun test --isolate scrapers/myChart/__tests__/*.test.ts scrapers/myChart/eunity/__tests__/*.test.ts shared/__tests__/*.test.ts npm-package/cli/__tests__/*.test.ts expo-app/src/lib/*/__tests__/*.test.ts claude-desktop-extension/src/__tests__/*.test.ts openrecord-splash/__tests__/*.test.ts openrecord-splash/demo/__tests__/*.test.ts openrecord-demo-lambda/src/__tests__/*.test.ts",
    "test:unit:web": "cd web && bun test --isolate",
    "test:integration": "NODE_ENV=development bun test scrapers/myChart/__tests__/integration/",
    "test:fake-mychart": "bun test scrapers/myChart/__tests__/fake-mychart/",
    "test:ci-integration": "bun test tests/integration/ci/",
    "deploy": "python3 node_modules/deploy/main.py --config web/deploy.yaml"
  },
