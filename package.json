  "scripts": {
    "fix": "eslint --fix",
    "knip": "knip",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cli": "bun npm-package/cli/entry.ts",
    "fake-mychart": "cd fake-mychart && bun run dev",
    "version:manifest": "bun openrecord-splash/generate-version.ts",
    "test": "bun test --isolate .unit.test.ts",
    "test:integration": "bun test --isolate .integration.test.ts",
    "test:real-mychart": "NODE_ENV=development bun test --isolate .real-mychart.test.ts",
    "test:unit": "bun run test",
    "test:coverage": "bun test --isolate --coverage .unit.test.ts .integration.test.ts"
  },
  "dependencies": {
    "cbor-x": "^1.6.9",
    "cheerio": "^1.2.0",
    "compare-versions": "^6.1.1",
    "date-fns": "^4.4.0",
    "fzstd": "^0.1.1",
    "html-to-text": "^10.0.1",
    "jpeg-js": "^0.4.4",
    "js-base64": "^3.9.6",
    "markdown-table": "^3.1.0",
    "node-sqlite3-wasm": "^0.8.61",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "totp-generator": "^2.0.1",
    "tough-cookie": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "playwright": "^1.65.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
