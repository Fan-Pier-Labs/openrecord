  "scripts": {
    "fix": "eslint --fix",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cli": "bun npm-package/cli/entry.ts",
    "fake-mychart": "cd fake-mychart && bun run dev",
    "test": "bun test --isolate .unit.test.ts",
    "test:integration": "bun test --isolate .integration.test.ts",
    "test:real-mychart": "NODE_ENV=development bun test --isolate .real-mychart.test.ts",
    "test:unit": "bun run test",
    "test:coverage": "bun test --isolate --coverage .unit.test.ts .integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "cbor-x": "^1.6.5",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "fzstd": "^0.1.1",
    "jpeg-js": "^0.4.4",
    "mkdirp": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "totp-generator": "^2.0.1",
    "tough-cookie": "^6.0.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.3.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
